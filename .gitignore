**/__pycache__/
**/*.pyc
**/.DS_Store
.vscode/

# Secrets — evalgrid/lib/bootstrap.py loads ROOT/.env (OPENAI_API_KEY etc.)
.env
.env.*
!.env.example

# Datasets (downloaded separately; see evalgrid/benchmarks/adapters/__init__.py)
data/

# vector store data
qdrant_data/
lancedb_data/
# mem0's per-process state: its Qdrant store, history.db and MEM0_DIR
mem0_data/

# Job logs + vllm server logs (may embed machine/user paths — never commit)
logs/
*.log
nohup.out

# Pipeline artifacts — regenerated by the five stages; nothing here is committed
# (including the per-store ingest_usage.json cost records).
outputs/

# vendored upstream toolkit — 170 files, not referenced anywhere in this repo
vendor/lightmem/memory_toolkits/

/.idea

# Scratch working files
/tmp/
